// ─────────────────────────────────────────────────────────────────────────────
// 50 — Processes spawned at login
// ─────────────────────────────────────────────────────────────────────────────
// Each line runs once when Niri starts. For daemons that support it,
// xdg-desktop-autostart (systemd) is an alternative.
//
// Tip: use spawn-sh-at-startup for shell pipelines or variable expansion.
// ─────────────────────────────────────────────────────────────────────────────


// WehttamSnaps Niri Configuration
// Author: Matthew (Crowdrocker)
// Hardware: AM5 Build - Ryzen 5 9600X, XFX RX 7600 8GB, 16GB DDR5 RAM, 850W PSU
// Display: DP-2 1920x1080@60Hz

// ╭─────────────────────────────── AUTOSTART ────────────────────────────────────────╮

// ─────────────────────────────────────────────────────────────────────────────
// 50 — Processes spawned at login (Void Linux + iNiR)
// ─────────────────────────────────────────────────────────────────────────────

// 1. Void Linux D-Bus & Environment (PipeWire/WirePlumber managed by Turnstile/XDG autostart)
spawn-at-startup "dbus-update-activation-environment" "--all"


// 2. Core System Bridges & Wayland Tools
spawn-at-startup "bash" "-c" "wl-paste --no-newline --type text --watch ~/.config/quickshell/inir/scripts/lib/accel-run clipboard-store &"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch ~/.config/quickshell/inir/scripts/clipboard-image-store.sh &"
spawn-at-startup "udiskie" "--tray"
spawn-at-startup "blueman-applet"
spawn-at-startup "nm-applet"
spawn-sh-at-startup "command -v niri-focused-booster >/dev/null 2>&1 && [ -r /sys/fs/cgroup/dmem.capacity ] && exec niri-focused-booster"
spawn-sh-at-startup "niriswitcher"

// 3. Personalized Creative & System Customization Scripts
spawn-at-startup "bash" "-c" "~/.config/niri/scripts/config-watcher.sh start &"
spawn-at-startup "~/.config/niri/scripts/save-program-list.sh"

// Interactive J.A.R.V.I.S Initialization with Audio Router Setup
spawn-at-startup "sh" "-c" "sound-system startup && notify-send 'J.A.R.V.I.S.' 'Systems online. Welcome back, Matthew.' -i audio-speakers"

// 4. iNiR Turnstile Environment (Exports DISPLAY + Wayland vars to iNiR & Void Polkit)
// BEGIN inir-turnstile-environment
spawn-sh-at-startup "export PATH=\"$HOME/.local/bin:$PATH\"; if command -v turnstile-update-runit-env >/dev/null 2>&1 && [ -n \"${WAYLAND_DISPLAY:-}\" ] && [ -n \"${XDG_RUNTIME_DIR:-}\" ] && [ -n \"${DBUS_SESSION_BUS_ADDRESS:-}\" ]; then turnstile-update-runit-env PATH WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS NIRI_SOCKET; if command -v sv >/dev/null 2>&1 && [ -d \"$HOME/.config/service/inir\" ]; then sv restart \"$HOME/.config/service/inir\" >/dev/null 2>&1 || true; fi; fi"
spawn-sh-at-startup "for agent in /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do if [ -x \"$agent\" ]; then exec \"$agent\"; fi; done"
// END inir-turnstile-environment

// >>> inir-managed-autostart >>>
// Delay Steam 3 seconds so XWayland and D-Bus finish initializing first
spawn-at-startup "sh" "-c" "sleep 3 && gtk-launch steam"
// <<< inir-managed-autostart <<<

// ╰──────────────────────────────────────────────────────────────────────────────────╯
